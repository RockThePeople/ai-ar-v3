# ai-ar-v3 — 환경변수 이름만. 값은 절대 커밋하지 않는다.
#
#   cp .env.example .env    후 각자 로컬에서 값을 채운다.
#   .env 는 .gitignore 로 봉쇄돼 있고 gitleaks 가 pre-commit 에서 한 번 더 막는다.
#
# 규칙 (docs/PROGRESS.md §7)
#   공인 IP · 포트 조합 · ngrok URL · 실제 호스트명 · 홈 경로 · API 키를
#   코드와 문서에 직접 쓰지 않는다. 전부 아래 이름으로만 참조한다.
#   문서에는 <EDIT_HOST>:<PORT> 형태로만 쓴다.

# ── 호스트 ────────────────────────────────────────────────
# 3090 측 — 오케스트레이터 · t2i · DebugView
GEN_HOST=
# A5000 측 — TRELLIS · VoxHammer
EDIT_HOST=

# ── 서비스 엔드포인트 ─────────────────────────────────────
# 자산 생성 서비스 URL (스킴 포함, 트레일링 슬래시 없음)
ASSETGEN_URL=
# DebugView 가 바인딩할 포트
DEBUGVIEW_PORT=

# ── LLM (server/llm.py) ───────────────────────────────────
# 비우면 규칙 기반 폴백으로 돈다 (instruction 을 그대로 target_prompt 로).
# 키 유무 **로만** 갈린다.
ANTHROPIC_API_KEY=
# 비우면 claude-opus-5.
LLM_MODEL=

# ── 경로 ──────────────────────────────────────────────────
# t2i 산출 이미지 디렉터리 (절대경로. 홈 경로를 코드에 박지 않기 위한 것)
T2I_OUT_DIR=
