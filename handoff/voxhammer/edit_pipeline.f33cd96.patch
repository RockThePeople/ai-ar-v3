+# ── W39 가설 G: self-attention 에서 편집 Query → 보존 Key 를 막는다 ─────────────
+# VoxHammer 는 보존 영역의 K,V 를 캐시된 원본으로 교체하지만 QKᵀ 는 여전히 전토큰에
+# 대해 돈다 ⇒ 편집 Query 가 원본 Value 를 끌어온다. 논문은 optional attention mask 를
+# 언급하고 구현하지 않았다. 환경변수로 켠다 (기본 꺼짐 = 기존 거동과 동일).
+W39_ATTN_MASK = os.environ.get("W39_ATTN_MASK") == "1"
+W39_STATS = {}
+
+def _w39_allow(is_edit, tag, heads):
+    """allow[i,j] = (not edit_i) or edit_j — 편집 Query → 보존 Key 만 막는다.
+    SDPA 의 bool attn_mask 는 True 가 '참여'다 (단위확인 완료)."""
+    allow = (~is_edit).unsqueeze(1) | is_edit.unsqueeze(0)
+    s = W39_STATS.setdefault(tag, {"calls": 0, "tokens": int(is_edit.numel()),
+                                   "edit": int(is_edit.sum()), "blocked_per_call_per_head": 0,
+                                   "blocked_total": 0, "min_row_allow": 10**9})
+    s["calls"] += 1
+    b = int((~allow).sum())
+    s["blocked_per_call_per_head"] = b
+    s["blocked_total"] += b * heads
+    s["min_row_allow"] = min(s["min_row_allow"], int(allow.sum(1).min()))
+    return allow
