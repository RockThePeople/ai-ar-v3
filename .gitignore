!*.env.example

*.key
*.pem
*.p12
*.jks
*.keystore
*.crt
id_rsa*
id_ed25519*
secrets*
credentials*
ngrok.yml
ngrok.yaml

# ai-ar-v2 에서 넘어오면 안 되는 것 (실제 64-hex 키가 들어 있다)
blockedit_local_key.txt

# ─────────────────────────────────────────────────────────────
